---
import Layout from "../../layouts/main.astro";
import PortableBody from "../../components/PortableBody.astro";
import SanityImage from "../../components/SanityImage.astro";
import { sanityClient } from "sanity:client";
import { POST_QUERY, POST_SLUGS_QUERY } from "../../lib/sanity/queries";
import type { Post, StaticSlugPath } from "../../lib/sanity/types";

export async function getStaticPaths() {
  const posts =
    (await sanityClient.fetch<StaticSlugPath[] | null>(POST_SLUGS_QUERY)) ?? [];
  return posts;
}

const { slug } = Astro.params;
const post = await sanityClient.fetch<Post | null>(POST_QUERY, { slug });

if (!post) {
  return new Response("Not found", { status: 404, statusText: "Not Found" });
}

const published = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString()
  : null;
---

<Layout title={post.title}>
  <main class="container mx-auto min-h-screen max-w-3xl p-8 flex flex-col gap-4">
    <a href="/posts" class="hover:underline">&larr; Back to posts</a>
    <SanityImage
      image={post.image}
      alt={post.title}
      width={550}
      height={310}
      class="aspect-video rounded-xl"
    />
    <h1 class="text-4xl font-bold mb-8">{post.title}</h1>
    {published && <p>Published: {published}</p>}
    <PortableBody value={post.body} />
  </main>
</Layout>
