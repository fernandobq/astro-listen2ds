---
import Layout from "../../layouts/main.astro";
import AlbumCard from "../../components/AlbumCard.astro";
import ArtistCard from "../../components/ArtistCard.astro";
import { sanityClient } from "sanity:client";
import { GENRE_QUERY, GENRE_SLUGS_QUERY } from "../../lib/sanity/queries";
import type { Genre, StaticSlugPath } from "../../lib/sanity/types";

export async function getStaticPaths() {
  const genres =
    (await sanityClient.fetch<StaticSlugPath[] | null>(GENRE_SLUGS_QUERY)) ??
    [];
  return genres;
}

const { slug } = Astro.params;
const genre = await sanityClient.fetch<Genre | null>(GENRE_QUERY, { slug });

if (!genre) {
  return new Response("Not found", { status: 404, statusText: "Not Found" });
}

const albums = genre.albums ?? [];
const artists = genre.artists ?? [];
---

<Layout title={genre.name}>
  <main class="container mx-auto min-h-screen max-w-3xl p-8 flex flex-col gap-4">
    <h1 class="text-4xl font-bold">{genre.name}</h1>
    {genre.description && <p>{genre.description}</p>}
    {
      artists.length > 0 && (
        <section class="flex flex-col gap-4 mt-4">
          <h2 class="text-2xl font-bold">Artists</h2>
          <ul class="flex flex-col gap-y-4">
            {artists.map((artist) => (
              <li>
                <ArtistCard artist={artist} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      albums.length > 0 && (
        <section class="flex flex-col gap-4 mt-4">
          <h2 class="text-2xl font-bold">Albums</h2>
          <ul class="flex flex-col gap-y-4">
            {albums.map((album) => (
              <li>
                <AlbumCard album={album} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Layout>
