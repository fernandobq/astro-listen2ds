---
import Hero from "./Hero.astro";
import RichText from "./RichText.astro";
import FeaturedPosts from "./FeaturedPosts.astro";
import FeaturedAlbums from "./FeaturedAlbums.astro";
import FeaturedArtists from "./FeaturedArtists.astro";
import type { PageBuilderBlock } from "../../lib/sanity/types";

interface Props {
  blocks?: PageBuilderBlock[] | null;
}

const { blocks } = Astro.props;
---

{
  blocks?.map((block) => {
    switch (block._type) {
      case "hero":
        return <Hero block={block} />;
      case "richText":
        return <RichText block={block} />;
      case "featuredPosts":
        return <FeaturedPosts block={block} />;
      case "featuredAlbums":
        return <FeaturedAlbums block={block} />;
      case "featuredArtists":
        return <FeaturedArtists block={block} />;
      default:
        return null;
    }
  })
}
