---
import Chips from "./ui/Chips.astro";
import type { GenreRef } from "../lib/sanity/types";

interface Props {
  genres?: GenreRef[] | null;
}

const { genres } = Astro.props;

const items = (genres ?? [])
  .filter((genre) => genre?.name)
  .map((genre) => ({
    name: genre.name,
    href: genre.generatePage && genre.slug ? `/genres/${genre.slug}` : null,
  }));
---

<Chips items={items} />
