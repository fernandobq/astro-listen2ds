---
import Row from "./ui/Row.astro";
import SanityImage from "./SanityImage.astro";
import type { PostCardData } from "../lib/sanity/types";

interface Props {
  post: PostCardData;
}

const { post } = Astro.props;
const href = post.slug ? `/posts/${post.slug}` : null;
const published = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString("es", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;
---

<Row variant="post" href={href} title={post.title} meta={published}>
  <div
    slot={post.image ? "cover" : undefined}
    class="aspect-video w-full border border-hairline"
  >
    {
      post.image && (
        <SanityImage
          image={post.image}
          alt={post.title}
          width={300}
          height={169}
          class="h-full w-full object-cover"
        />
      )
    }
  </div>
</Row>
