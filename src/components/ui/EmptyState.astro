---
interface Props {
  line: string;
}

const { line } = Astro.props;
---

<div class="flex flex-col gap-2 border-t border-hairline pt-6">
  <div class="text-screen">{line}</div>
  {
    Astro.slots.has("default") && (
      <div class="max-w-[52ch] text-meta text-dim">
        <slot />
      </div>
    )
  }
</div>
